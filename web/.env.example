# ---- Which chain the app talks to: local | base-sepolia | zero
NEXT_PUBLIC_CHAIN=local
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Block the launchpad was deployed at (speeds up log queries)
NEXT_PUBLIC_START_BLOCK=0
# Max block range per eth_getLogs call. 0 = unlimited (anvil). Public Base Sepolia RPC needs 200.
NEXT_PUBLIC_LOG_CHUNK=0

# ---- Zero chain (fill in once LayerZero publishes it)
NEXT_PUBLIC_ZERO_CHAIN_ID=
NEXT_PUBLIC_ZERO_RPC_URL=
NEXT_PUBLIC_ZERO_EXPLORER=
NEXT_PUBLIC_ZERO_NATIVE_SYMBOL=ZRO

# ---- Server-only RPC used by /api/rpc (keeps paid RPC keys off the client). Falls back to the chain default.
RPC_URL=

# ---- Pre-launch mode: shows the landing page at / and hides the app
NEXT_PUBLIC_PRELAUNCH=false
NEXT_PUBLIC_LAUNCH_DATE=2026-11-30T16:00:00Z

# ---- Image + metadata storage. With PINATA_JWT set, uploads go to IPFS; otherwise to public/uploads (dev only).
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---- Optional Ponder indexer (../indexer). When set, lists/charts/points read from it instead of raw logs.
NEXT_PUBLIC_INDEXER_URL=
